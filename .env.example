# Gaon Auto Environment Configuration

# Server
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
ADMIN_WEB_URL=http://localhost:5173
MOBILE_APP_SCHEME=gaonauto://

# Database
MONGODB_URI=mongodb://localhost:27017/gaon_auto

# JWT Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_gaon_auto_2026_super_secure_key
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_gaon_auto_2026_super_secure_key

# SMS Gateway Configuration
# Supported providers: MOCK (development only), MSG91, FAST2SMS, TWILIO
SMS_PROVIDER=MOCK
# In production, SMS_PROVIDER must be set to a real gateway. MOCK will fail startup in production.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Document Storage
# Type: LOCAL (default) or S3
STORAGE_TYPE=LOCAL
UPLOAD_DIR=./data/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=gaon-auto-documents-private

# Operational Defaults
INITIAL_SEARCH_RADIUS_KM=3.0
MAX_SEARCH_RADIUS_KM=10.0
RADIUS_EXPANSION_STEP_KM=2.0
MAX_DRIVERS_CONTACTED_PER_RIDE=10
RIDE_SEARCH_TIMEOUT_SECONDS=120
FARE_OFFER_TIMEOUT_SECONDS=90
